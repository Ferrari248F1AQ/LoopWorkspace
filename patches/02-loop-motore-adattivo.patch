+// MARK: - Widget per la schermata di blocco
+//
+// Vivono nello stesso processo della Live Activity, che ha pochissima memoria.
+// Regola: nessun impianto nuovo. Un solo fornitore di dati (`.shared`, condiviso con
+// il widget della Home, quindi un database aperto invece di due), nessun campo nuovo
+// nel pacchetto che l'app scrive, nessuna immagine, nessun grafico. Solo testo e
+// numeri che il widget gia' riceve.
+
+extension View {
+    /// Da iOS 17 lo sfondo va dichiarato, altrimenti il sistema ne disegna uno suo.
+    @ViewBuilder
+    func accessoryWidgetBackgroundIfAvailable() -> some View {
+        if #available(iOSApplicationExtension 17.0, *) {
+            self.containerBackground(for: .widget) { AccessoryWidgetBackground() }
+        } else {
+            self
+        }
+    }
+
+    @ViewBuilder
+    func clearWidgetBackgroundIfAvailable() -> some View {
+        if #available(iOSApplicationExtension 17.0, *) {
+            self.containerBackground(for: .widget) { Color.clear }
+        } else {
+            self
+        }
+    }
+}
+
+@available(iOS 16.0, *)
+enum LockScreenFormatting {
+
+    private static let basalFormatter: NumberFormatter = {
+        let formatter = NumberFormatter()
+        formatter.numberStyle = .decimal
+        formatter.minimumFractionDigits = 2
+        formatter.maximumFractionDigits = 2
+        return formatter
+    }()
+
+    static func glucoseString(_ entry: StatusWidgetTimelimeEntry) -> String {
+        guard let glucose = entry.currentGlucose,
+              !entry.glucoseIsStale,
+              let unit = entry.unit,
+              let string = NumberFormatter.glucoseFormatter(for: unit)
+                .string(from: glucose.quantity.doubleValue(for: unit))
+        else {
+            return "---"
+        }
+        return string
+    }
+
+    /// Freccia di tendenza: il glifo semplice, non quello dentro il cerchio. A queste
+    /// dimensioni il cerchio diventa una macchia.
+    static func trendSymbol(_ entry: StatusWidgetTimelimeEntry) -> String? {
+        guard !entry.glucoseIsStale else { return nil }
+        switch entry.sensor?.trendType {
+        case .upUpUp, .upUp: return "arrow.up"
+        case .up: return "arrow.up.right"
+        case .flat: return "arrow.right"
+        case .down: return "arrow.down.right"
+        case .downDown, .downDownDown: return "arrow.down"
+        case .none: return nil
+        }
+    }
+
+    static func deltaString(_ entry: StatusWidgetTimelimeEntry) -> String? {
+        guard let delta = entry.delta, let unit = entry.unit else { return nil }
+        let value = delta.doubleValue(for: unit)
+        guard let formatted = NumberFormatter.glucoseFormatter(for: unit).string(from: abs(value)) else {
+            return nil
+        }
+        return (value < 0 ? "-" : "+") + formatted
+    }
+
+    /// Glicemia prevista, con la freccia che la introduce.
+    static func eventualString(_ entry: StatusWidgetTimelimeEntry) -> String? {
+        guard let eventual = entry.eventualGlucose else { return nil }
+        let unit = eventual.unit
+        guard let formatted = NumberFormatter.glucoseFormatter(for: unit)
+            .string(from: eventual.quantity.doubleValue(for: unit)) else { return nil }
+        return "\u{21AA} " + formatted
+    }
+
+    /// Basale effettiva in unita' l'ora, quella che Loop sta davvero erogando.
+    static func basalString(_ entry: StatusWidgetTimelimeEntry) -> String? {
+        guard let netBasal = entry.netBasal,
+              let formatted = basalFormatter.string(from: NSNumber(value: netBasal.rate))
+        else {
+            return nil
+        }
+        return formatted + " U/h"
+    }
+
+    static func carbsOnBoardString(_ entry: StatusWidgetTimelimeEntry) -> String? {
+        guard let cob = entry.carbsOnBoard else { return nil }
+        return String(format: "%.0f g", cob)
+    }
+
+    /// Ora dell'ultima lettura: senza, un dato fermo e uno fresco si somigliano troppo.
+    static func updatedString(_ entry: StatusWidgetTimelimeEntry) -> String? {
+        guard let date = entry.currentGlucose?.startDate else { return nil }
+        let formatter = DateFormatter()
+        formatter.dateStyle = .none
+        formatter.timeStyle = .short
+        return formatter.string(from: date)
+    }
+
+    static func line(_ pieces: [String?]) -> String {
+        pieces.compactMap { $0 }.joined(separator: "  \u{00B7}  ")
+    }
+
+    /// Posizione della glicemia dentro l'intervallo leggibile, per riempire l'anello.
+    /// Non e' un intervallo terapeutico: serve solo al colpo d'occhio.
+    static func gaugeFraction(_ entry: StatusWidgetTimelimeEntry) -> Double? {
+        guard let glucose = entry.currentGlucose, !entry.glucoseIsStale else { return nil }
+        let mgdl = glucose.quantity.doubleValue(for: .milligramsPerDeciliter)
+        return min(max((mgdl - 40) / (300 - 40), 0), 1)
+    }
+}
+
+@available(iOS 16.0, *)
+struct LockScreenCircularView: View {
+    var entry: StatusWidgetTimelineProvider.Entry
+
+    var body: some View {
+        Group {
+            if let fraction = LockScreenFormatting.gaugeFraction(entry) {
+                Gauge(value: fraction) {
+                    EmptyView()
+                } currentValueLabel: {
+                    Text(LockScreenFormatting.glucoseString(entry))
+                        .font(.system(.title3, design: .rounded).weight(.semibold))
+                        .minimumScaleFactor(0.6)
+                }
+                .gaugeStyle(.accessoryCircular)
+            } else {
+                ZStack {
+                    AccessoryWidgetBackground()
+                    Text("---")
+                        .font(.system(.title3, design: .rounded).weight(.semibold))
+                }
+            }
+        }
+        .accessoryWidgetBackgroundIfAvailable()
+    }
+}
+
+@available(iOS 16.0, *)
+struct LockScreenRectangularView: View {
+    var entry: StatusWidgetTimelineProvider.Entry
+
+    var body: some View {
+        // Tre fasce a tutta larghezza, non elementi affiancati che si contendono lo
+        // spazio: in 160x72 punti si legge solo se ogni fascia ha un compito solo.
+        VStack(alignment: .leading, spacing: 1) {
+
+            // 1. Quello che leggi in mezzo secondo.
+            HStack(alignment: .firstTextBaseline, spacing: 4) {
+                Text(LockScreenFormatting.glucoseString(entry))
+                    .font(.system(size: 24, weight: .bold, design: .rounded))
+
+                if let symbol = LockScreenFormatting.trendSymbol(entry) {
+                    Image(systemName: symbol)
+                        .font(.system(size: 12, weight: .bold))
+                }
+
+                if let delta = LockScreenFormatting.deltaString(entry) {
+                    Text(delta)
+                        .font(.system(size: 12, weight: .medium))
+                        .foregroundStyle(.secondary)
+                }
+
+                Spacer(minLength: 0)
+            }
+            .lineLimit(1)
+
+            // 2. Dove sta andando e quanto sta erogando.
+            Text(LockScreenFormatting.line([
+                LockScreenFormatting.eventualString(entry),
+                LockScreenFormatting.basalString(entry)
+            ]))
+                .font(.system(size: 11, weight: .medium))
+                .lineLimit(1)
+
+            // 3. Il contorno. Niente icone: a dieci punti diventano macchie, e le unita'
+            //    (g, l'ora) dicono gia' di cosa si tratta.
+            Text(LockScreenFormatting.line([
+                LockScreenFormatting.carbsOnBoardString(entry),
+                LockScreenFormatting.updatedString(entry)
+            ]))
+                .font(.system(size: 10, weight: .medium))
+                .foregroundStyle(.secondary)
+                .lineLimit(1)
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .leading)
+        .opacity(entry.contextIsStale ? 0.5 : 1)
+        .clearWidgetBackgroundIfAvailable()
+    }
+}
+
+@available(iOS 16.0, *)
+struct LockScreenInlineView: View {
+    var entry: StatusWidgetTimelineProvider.Entry
+
+    var body: some View {
+        // I widget in linea sono una riga sola: niente impaginazione, solo testo.
+        let text = [
+            LockScreenFormatting.glucoseString(entry),
+            LockScreenFormatting.deltaString(entry),
+            LockScreenFormatting.eventualString(entry)
+        ].compactMap { $0 }.joined(separator: "  ")
+
+        if let symbol = LockScreenFormatting.trendSymbol(entry) {
+            Label {
+                Text(text)
+            } icon: {
+                Image(systemName: symbol)
+            }
+        } else {
+            Text(text)
+        }
+    }
+}
+
+@available(iOS 16.0, *)
+struct LockScreenWidgetEntryView: View {
+    @Environment(\.widgetFamily) private var family
+    var entry: StatusWidgetTimelineProvider.Entry
+
+    var body: some View {
+        switch family {
+        case .accessoryRectangular:
+            LockScreenRectangularView(entry: entry)
+        case .accessoryInline:
+            LockScreenInlineView(entry: entry)
+        default:
+            LockScreenCircularView(entry: entry)
+        }
+    }
+}
+
+@available(iOS 16.0, *)
+struct LockScreenGlucoseWidget: Widget {
+    let kind: String = "LockScreenGlucoseWidget"
+
+    var body: some WidgetConfiguration {
+        StaticConfiguration(kind: kind, provider: StatusWidgetTimelineProvider.shared) { entry in
+            LockScreenWidgetEntryView(entry: entry)
+        }
+        .configurationDisplayName(LocalizedString("Glucose", comment: "Display name of the lock screen glucose widget"))
+        .description(LocalizedString("Your glucose on the Lock Screen.", comment: "Description of the lock screen glucose widget"))
+        .supportedFamilies([.accessoryCircular, .accessoryRectangular, .accessoryInline])
+    }
+}
