diff --git a/Loop/Loop/Managers/AdaptiveTherapyManager.swift b/Loop/Loop/Managers/AdaptiveTherapyManager.swift
new file mode 100644
index 00000000..9fd964c0
--- /dev/null
+++ b/Loop/Loop/Managers/AdaptiveTherapyManager.swift
@@ -0,0 +1,1281 @@
+//
+//  AdaptiveTherapyManager.swift
+//  Loop
+//
+//  Motore retrospettivo multi-giorno: stima quanto il profilo basale e l'ISF sono
+//  sbagliati, fascia per fascia, usando solo le finestre temporali in cui la glicemia
+//  si e' mossa per la terapia e non per un evento esterno.
+//
+//  In questa fase il motore CALCOLA E BASTA. Non tocca il dosaggio, non scrive le
+//  therapy settings, non erogare nulla. L'unico effetto e' un rapporto consultabile.
+//
+//  Differenze rispetto ai due algoritmi noti da cui prende le idee:
+//   - la retrospective correction di Loop guarda le ultime 3 ore e non esclude i pasti;
+//   - autotune attribuisce la deviazione all'ora in cui la vede invece che all'ora in
+//     cui e' stata erogata l'insulina che l'ha causata.
+//  Qui i pasti pesano invece di essere buttati (pesi continui) e la deviazione viene
+//  riportata indietro secondo la curva di attivita' insulinica.
+//
+
+import Foundation
+import HealthKit
+import LoopCore
+import LoopKit
+import os.log
+
+/// Fotografia delle impostazioni terapeutiche al momento dell'analisi.
+struct AdaptiveTherapyInputs {
+    let basalSchedule: BasalRateSchedule
+    let insulinSensitivitySchedule: InsulinSensitivitySchedule
+    /// Serve solo al percorso Nightscout, per ricostruire l'assorbimento dei carboidrati
+    /// senza passare dal CarbStore.
+    let carbRatioSchedule: CarbRatioSchedule?
+    let targetSchedule: GlucoseRangeSchedule
+    let suspendThreshold: HKQuantity?
+    let integralRetrospectiveCorrectionEnabled: Bool
+}
+
+/// Le cinque serie temporali su cui lavora il motore, comunque siano state ottenute.
+struct AdaptiveSeries {
+    let glucose: [StoredGlucoseSample]
+    let counteraction: [GlucoseEffectVelocity]
+    let cobValues: [CarbValue]
+    let carbEffects: [GlucoseEffect]
+    let iobValues: [InsulinValue]
+    let source: AdaptiveDataSource
+}
+
+final class AdaptiveTherapyManager {
+
+    private let log = OSLog(category: "AdaptiveTherapyManager")
+
+    private let glucoseStore: GlucoseStore
+    private let carbStore: CarbStore
+    private let doseStore: DoseStore
+
+    /// Fornisce basale, ISF e target correnti. E' una closure per non legare il motore
+    /// al ciclo di vita di LoopDataManager.
+    private let inputsProvider: () -> AdaptiveTherapyInputs?
+
+    /// Fonte esterna per lo storico, quando gli archivi locali non bastano.
+    private let historicalServiceProvider: () -> HistoricalTherapyDataService?
+
+    private let configuration: AdaptiveTherapyConfiguration
+
+    static let reportKey = "com.loopkit.adaptiveTherapy.latestReport"
+    static let stateKey = "com.loopkit.adaptiveTherapy.multipliers"
+    static let isfStateKey = "com.loopkit.adaptiveTherapy.isfMultipliers"
+
+    /// Evita analisi sovrapposte: il calcolo gira su piu' giorni di dati e non ha senso
+    /// lanciarlo a ogni ciclo.
+    private let isAnalyzing = Locked(false)
+    private let lastAnalysisDate = Locked<Date?>(nil)
+
+    init(glucoseStore: GlucoseStore,
+         carbStore: CarbStore,
+         doseStore: DoseStore,
+         configuration: AdaptiveTherapyConfiguration = .default,
+         inputsProvider: @escaping () -> AdaptiveTherapyInputs?,
+         historicalServiceProvider: @escaping () -> HistoricalTherapyDataService? = { nil })
+    {
+        self.glucoseStore = glucoseStore
+        self.carbStore = carbStore
+        self.doseStore = doseStore
+        self.configuration = configuration
+        self.inputsProvider = inputsProvider
+        self.historicalServiceProvider = historicalServiceProvider
+    }
+
+    // MARK: - Stato persistito
+
+    /// Ultimo rapporto prodotto. Statico perche' la schermata di osservazione lo legge
+    /// senza dover conoscere l'istanza del motore.
+    static var storedReport: AdaptiveTherapyReport? {
+        guard let data = UserDefaults.standard.data(forKey: reportKey) else { return nil }
+        return try? JSONDecoder().decode(AdaptiveTherapyReport.self, from: data)
+    }
+
+    var latestReport: AdaptiveTherapyReport? {
+        AdaptiveTherapyManager.storedReport
+    }
+
+    private func store(_ report: AdaptiveTherapyReport) {
+        guard let data = try? JSONEncoder().encode(report) else { return }
+        UserDefaults.standard.set(data, forKey: AdaptiveTherapyManager.reportKey)
+    }
+
+    /// Moltiplicatori correnti per fascia, chiave = minuti dalla mezzanotte.
+    /// In fase di sola osservazione nessuno li legge per dosare: servono a rendere
+    /// graduale l'aggiornamento e a mostrare la traiettoria nel tempo.
+    private var storedIsfMultipliers: [Int: Double] {
+        get { AdaptiveTherapyManager.multipliers(forKey: AdaptiveTherapyManager.isfStateKey) }
+        set { AdaptiveTherapyManager.setMultipliers(newValue, forKey: AdaptiveTherapyManager.isfStateKey) }
+    }
+
+    private static func multipliers(forKey key: String) -> [Int: Double] {
+        guard let data = UserDefaults.standard.data(forKey: key),
+              let decoded = try? JSONDecoder().decode([String: Double].self, from: data)
+        else {
+            return [:]
+        }
+        var result: [Int: Double] = [:]
+        for (slot, value) in decoded {
+            if let slot = Int(slot) { result[slot] = value }
+        }
+        return result
+    }
+
+    private static func setMultipliers(_ values: [Int: Double], forKey key: String) {
+        var encodable: [String: Double] = [:]
+        for (slot, value) in values { encodable[String(slot)] = value }
+        guard let data = try? JSONEncoder().encode(encodable) else { return }
+        UserDefaults.standard.set(data, forKey: key)
+    }
+
+    private var storedMultipliers: [Int: Double] {
+        get {
+            guard let data = UserDefaults.standard.data(forKey: AdaptiveTherapyManager.stateKey),
+                  let decoded = try? JSONDecoder().decode([String: Double].self, from: data)
+            else {
+                return [:]
+            }
+            var result: [Int: Double] = [:]
+            for (key, value) in decoded {
+                if let slot = Int(key) { result[slot] = value }
+            }
+            return result
+        }
+        set {
+            var encodable: [String: Double] = [:]
+            for (slot, value) in newValue { encodable[String(slot)] = value }
+            guard let data = try? JSONEncoder().encode(encodable) else { return }
+            UserDefaults.standard.set(data, forKey: AdaptiveTherapyManager.stateKey)
+        }
+    }
+
+    // MARK: - Ingresso
+
+    /// Chiamato a fine ciclo. Non fa nulla se l'ultima analisi e' recente.
+    func analyzeIfNeeded() {
+        guard UserDefaults.standard.adaptiveTherapyEnabled else { return }
+
+        if let last = lastAnalysisDate.value,
+           Date().timeIntervalSince(last) < configuration.minimumUpdateInterval
+        {
+            return
+        }
+
+        // Prenotazione atomica: analyzeIfNeeded() arriva dalla coda del ciclo Loop e il
+        // rilascio dal pool cooperativo, quindi una Bool nuda non basta.
+        var alreadyRunning = false
+        isAnalyzing.mutate { running in
+            alreadyRunning = running
+            running = true
+        }
+        guard !alreadyRunning else { return }
+
+        Task { [weak self] in
+            guard let self = self else { return }
+            defer {
+                // Anche in caso di errore: altrimenti un'analisi che fallisce sempre
+                // (per esempio ISF non configurato) ripartirebbe a ogni ciclo, cioe'
+                // ogni cinque minuti, su ventuno giorni di dati.
+                self.lastAnalysisDate.value = Date()
+                self.isAnalyzing.value = false
+            }
+
+            do {
+                let report = try await self.analyze()
+                self.store(report)
+                self.log.default("Analisi adattiva completata: %{public}d fasce utilizzabili su %{public}d",
+                                 report.actionableSlots.count, report.slots.count)
+            } catch {
+                self.log.error("Analisi adattiva fallita: %{public}@", String(describing: error))
+            }
+        }
+    }
+
+    // MARK: - Analisi
+
+    func analyze(asOf now: Date = Date()) async throws -> AdaptiveTherapyReport {
+        guard let inputs = inputsProvider() else {
+            return AdaptiveTherapyReport(dataSource: nil, generatedAt: now, windowStart: now, windowEnd: now,
+                                         slots: [], totalBins: 0, effectiveBins: 0,
+                                         exclusionCounts: [:], saturatedMeals: [],
+                                         carbRatio: nil, mealAssessments: nil,
+                                         inconclusiveReason: "Impostazioni terapeutiche non disponibili")
+        }
+
+        let windowEnd = now
+        // Allineata alla mezzanotte locale: altrimenti i bin sono sfasati fino a 29 minuti
+        // rispetto ai confini delle fasce su cui poi leggiamo basale, ISF e target.
+        let calendar = Calendar.current
+        let windowStart = calendar.startOfDay(for: now)
+            .addingTimeInterval(-.days(Double(configuration.analysisWindowDays)))
+
+        // 1. Dati grezzi. Se in locale non c'e' abbastanza storia si passa alla fonte esterna:
+        // e' il caso subito dopo una reinstallazione, o subito dopo aver allungato la finestra.
+        // Aspettare tre settimane prima che il motore apra bocca non ha senso se sul server
+        // quei dati ci sono gia'.
+        var series: AdaptiveSeries
+        var carbEntries: [StoredCarbEntry]
+
+        let localGlucose = try await glucoseStore.getGlucoseSamples(start: windowStart, end: windowEnd)
+        let expectedSamples = Double(configuration.analysisWindowDays) * 288
+        let localCoverage = expectedSamples > 0 ? Double(localGlucose.count) / expectedSamples : 0
+
+        if localCoverage >= configuration.minimumLocalCoverage {
+            series = try await localSeries(glucose: localGlucose, windowStart: windowStart, windowEnd: windowEnd)
+            carbEntries = try await carbStore.getCarbEntries(start: windowStart.addingTimeInterval(-.hours(12)), end: windowEnd)
+
+        } else if let service = historicalServiceProvider(), service.isHistoricalTherapyDataAvailable {
+            log.default("Copertura locale %{public}.0f%%: rileggo lo storico dalla fonte esterna",
+                        localCoverage * 100)
+
+            let data = try await historicalData(from: service, start: windowStart, end: windowEnd)
+            guard let built = backfilledSeries(from: data, windowStart: windowStart, windowEnd: windowEnd, inputs: inputs) else {
+                return AdaptiveTherapyReport(dataSource: .nightscout, generatedAt: now,
+                                             windowStart: windowStart, windowEnd: windowEnd,
+                                             slots: [], totalBins: 0, effectiveBins: 0,
+                                             exclusionCounts: [:], saturatedMeals: [],
+                                             carbRatio: nil, mealAssessments: nil,
+                                             inconclusiveReason: "Rapporto carboidrati non configurato: impossibile ricostruire lo storico esterno")
+            }
+            series = built
+            carbEntries = data.carbEntries
+
+        } else {
+            series = try await localSeries(glucose: localGlucose, windowStart: windowStart, windowEnd: windowEnd)
+            carbEntries = try await carbStore.getCarbEntries(start: windowStart.addingTimeInterval(-.hours(12)), end: windowEnd)
+        }
+
+        guard series.glucose.count > 12 else {
+            return AdaptiveTherapyReport(dataSource: series.source, generatedAt: now,
+                                         windowStart: windowStart, windowEnd: windowEnd,
+                                         slots: [], totalBins: 0, effectiveBins: 0,
+                                         exclusionCounts: [:], saturatedMeals: [],
+                                         carbRatio: nil, mealAssessments: nil,
+                                         inconclusiveReason: "Storico glicemico insufficiente, anche dopo aver provato la fonte esterna")
+        }
+
+        let glucose = series.glucose
+        let counteraction = series.counteraction
+        let cobValues = series.cobValues
+        let carbEffects = series.carbEffects
+        let iobValues = series.iobValues
+
+        // 2. Pasti che hanno saturato il tetto di assorbimento del modello.
+        let saturatedMeals = detectSaturatedMeals(entries: carbEntries, carbEffects: carbEffects)
+
+        // 3. Binning e pesi.
+        let bins = buildBins(windowStart: windowStart,
+                             windowEnd: windowEnd,
+                             glucose: glucose,
+                             counteraction: counteraction,
+                             cobValues: cobValues,
+                             carbEffects: carbEffects,
+                             iobValues: iobValues,
+                             saturatedMeals: saturatedMeals,
+                             inputs: inputs)
+
+        // 4. Deconvoluzione: la deviazione vista alle 4 appartiene all'insulina dell'1.
+        let attributed = deconvolve(bins)
+
+        // 5. Stima per fascia oraria.
+        var slots = estimateSlots(from: attributed, inputs: inputs)
+
+        // 6. Continuita' fra fasce adiacenti.
+        slots = smooth(slots)
+
+        // 7. Aggiornamento graduale rispetto allo stato precedente.
+        slots = applyGradualUpdate(slots)
+
+        // 8. Rapporto insulina/carboidrati. Guarda esattamente le finestre che tutto il
+        // resto del motore butta via: per leggere la basale servono le ore senza pasti, per
+        // leggere il rapporto servono solo quelle con i pasti.
+        let podChanges = (try? await podChangeDates(start: windowStart, end: windowEnd)) ?? []
+        let mealAssessments = assessMeals(carbEntries: carbEntries,
+                                          counteraction: counteraction,
+                                          glucose: glucose,
+                                          saturatedMeals: saturatedMeals,
+                                          podChanges: podChanges,
+                                          windowStart: windowStart,
+                                          windowEnd: windowEnd,
+                                          inputs: inputs)
+        let carbRatioRecommendation = summarizeCarbRatio(from: mealAssessments)
+
+        var exclusionCounts: [String: Int] = [:]
+        for bin in bins {
+            for reason in bin.exclusions {
+                exclusionCounts[reason.rawValue, default: 0] += 1
+            }
+        }
+
+        let report = AdaptiveTherapyReport(
+            dataSource: series.source,
+            generatedAt: now,
+            windowStart: windowStart,
+            windowEnd: windowEnd,
+            slots: slots,
+            totalBins: bins.count,
+            effectiveBins: bins.reduce(0) { $0 + $1.weight },
+            exclusionCounts: exclusionCounts,
+            saturatedMeals: saturatedMeals,
+            carbRatio: carbRatioRecommendation,
+            mealAssessments: mealAssessments,
+            inconclusiveReason: slots.contains(where: { $0.isActionable }) ? nil : "Nessuna fascia con dati sufficienti"
+        )
+
+        return report
+    }
+}
