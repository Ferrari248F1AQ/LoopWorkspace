diff --git a/Loop/Loop/Views/AdaptiveTherapyView.swift b/Loop/Loop/Views/AdaptiveTherapyView.swift
new file mode 100644
index 00000000..fbba710d
--- /dev/null
+++ b/Loop/Loop/Views/AdaptiveTherapyView.swift
@@ -0,0 +1,177 @@
+//
+//  AdaptiveTherapyView.swift
+//  Loop
+//
+//  Schermata di osservazione del motore adattivo. Mostra cosa il motore AVREBBE
+//  proposto: in questa fase non modifica nulla della terapia.
+//
+
+import SwiftUI
+import LoopKit
+
+public struct AdaptiveTherapyView: View {
+
+    @Binding private var isAdaptiveTherapyEnabled: Bool
+    @State private var report: AdaptiveTherapyReport?
+
+    public init(isAdaptiveTherapyEnabled: Binding<Bool>) {
+        self._isAdaptiveTherapyEnabled = isAdaptiveTherapyEnabled
+    }
+
+    public var body: some View {
+        List {
+            Section {
+                Toggle(NSLocalizedString("Adaptive Therapy", comment: "Title of the adaptive therapy toggle"),
+                       isOn: $isAdaptiveTherapyEnabled)
+            } footer: {
+                Text(NSLocalizedString("Observation only. The engine analyses the previous days and records what it would have proposed. It does not change basal rates, insulin sensitivity or any dose.", comment: "Footer explaining that adaptive therapy is observation only"))
+            }
+
+            if let report = report {
+                summarySection(report)
+                slotsSection(report)
+                exclusionsSection(report)
+                mealsSection(report)
+            } else {
+                Section {
+                    Text(NSLocalizedString("No analysis yet. The first report appears after the engine has run, which happens at the end of a loop cycle once enough history is available.", comment: "Placeholder when no adaptive therapy report exists"))
+                        .foregroundColor(.secondary)
+                }
+            }
+        }
+        .navigationTitle(NSLocalizedString("Adaptive Therapy", comment: "Navigation title of the adaptive therapy screen"))
+        .navigationBarTitleDisplayMode(.inline)
+        .onAppear {
+            report = AdaptiveTherapyManager.storedReport
+        }
+    }
+
+    // MARK: - Sezioni
+
+    private func summarySection(_ report: AdaptiveTherapyReport) -> some View {
+        Section(NSLocalizedString("Last analysis", comment: "Section header for the adaptive therapy summary")) {
+            row(NSLocalizedString("Generated", comment: "Label"), Self.dateFormatter.string(from: report.generatedAt))
+            row(NSLocalizedString("Window", comment: "Label"),
+                "\(Self.dayFormatter.string(from: report.windowStart)) – \(Self.dayFormatter.string(from: report.windowEnd))")
+            row(NSLocalizedString("Readable intervals", comment: "Label"),
+                String(format: "%.0f / %d", report.effectiveBins, report.totalBins))
+            row(NSLocalizedString("Usable time slots", comment: "Label"),
+                "\(report.actionableSlots.count) / \(report.slots.count)")
+
+            if let reason = report.inconclusiveReason {
+                Text(reason)
+                    .font(.footnote)
+                    .foregroundColor(.secondary)
+            }
+        }
+    }
+
+    private func slotsSection(_ report: AdaptiveTherapyReport) -> some View {
+        Section(NSLocalizedString("What it would have proposed", comment: "Section header for the per-slot proposals")) {
+            if report.actionableSlots.isEmpty {
+                Text(NSLocalizedString("No time slot had enough clean data.", comment: "Placeholder when no slot is actionable"))
+                    .foregroundColor(.secondary)
+            } else {
+                ForEach(report.actionableSlots) { slot in
+                    VStack(alignment: .leading, spacing: 4) {
+                        HStack {
+                            Text(slot.slotLabel)
+                                .font(.body.monospacedDigit())
+                            Spacer()
+                            Text(Self.percentString(slot.basalMultiplier))
+                                .foregroundColor(Self.color(for: slot.basalMultiplier))
+                                .font(.body.monospacedDigit())
+                        }
+                        Text(String(format: NSLocalizedString("sensitivity %@ · sample %.1f · spread %.0f mg/dL/h", comment: "Detail line under a slot proposal"),
+                                    Self.percentString(slot.insulinSensitivityMultiplier),
+                                    slot.effectiveSamples,
+                                    slot.dispersion))
+                            .font(.caption)
+                            .foregroundColor(.secondary)
+                    }
+                    .padding(.vertical, 2)
+                }
+            }
+        }
+    }
+
+    private func exclusionsSection(_ report: AdaptiveTherapyReport) -> some View {
+        Section {
+            if report.exclusionCounts.isEmpty {
+                Text(NSLocalizedString("Nothing was excluded.", comment: "Placeholder when no exclusions"))
+                    .foregroundColor(.secondary)
+            } else {
+                let ordered = report.exclusionCounts.sorted { $0.value > $1.value }.map { $0.key }
+                ForEach(ordered, id: \.self) { key in
+                    row(key, "\(report.exclusionCounts[key] ?? 0)")
+                }
+            }
+        } header: {
+            Text(NSLocalizedString("Why intervals were discarded", comment: "Section header for exclusion counts"))
+        } footer: {
+            Text(NSLocalizedString("On a normal day only a small part of the 24 hours is readable, usually the night. This is expected: everything else is moving because of food, not because of the therapy.", comment: "Footer explaining exclusions"))
+        }
+    }
+
+    private func mealsSection(_ report: AdaptiveTherapyReport) -> some View {
+        Section {
+            if report.saturatedMeals.isEmpty {
+                Text(NSLocalizedString("None found.", comment: "Placeholder when no long meals detected"))
+                    .foregroundColor(.secondary)
+            } else {
+                ForEach(Array(report.saturatedMeals.prefix(20).enumerated()), id: \.offset) { _, meal in
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(Self.dateFormatter.string(from: meal.startDate))
+                            .font(.body.monospacedDigit())
+                        Text(String(format: NSLocalizedString("%.0f g · declared %.1f h, still absorbing at %.1f h", comment: "Detail line for a long meal"),
+                                    meal.grams,
+                                    meal.declaredAbsorption / 3600,
+                                    meal.observedAbsorption / 3600))
+                            .font(.caption)
+                            .foregroundColor(.secondary)
+                    }
+                    .padding(.vertical, 2)
+                }
+            }
+        } header: {
+            Text(NSLocalizedString("Meals that absorbed longer than declared", comment: "Section header for long meals"))
+        } footer: {
+            Text(NSLocalizedString("These meals hit the ceiling of the absorption model, which is one and a half times the time you entered. Past that point the model reports no carbs on board while the meal is still absorbing, and the rise that follows looks like a low basal rate. Entering these meals with a longer absorption time raises the ceiling.", comment: "Footer explaining long meals"))
+        }
+    }
+
+    private func row(_ label: String, _ value: String) -> some View {
+        HStack {
+            Text(label)
+            Spacer()
+            Text(value)
+                .foregroundColor(.secondary)
+                .font(.body.monospacedDigit())
+        }
+    }
+
+    // MARK: - Formattazione
+
+    private static func percentString(_ multiplier: Double) -> String {
+        let percent = (multiplier - 1) * 100
+        return String(format: "%+.1f%%", percent)
+    }
+
+    private static func color(for multiplier: Double) -> Color {
+        abs(multiplier - 1) < 0.02 ? .secondary : .accentColor
+    }
+
+    private static let dateFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateStyle = .short
+        formatter.timeStyle = .short
+        return formatter
+    }()
+
+    private static let dayFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateStyle = .short
+        formatter.timeStyle = .none
+        return formatter
+    }()
+}
