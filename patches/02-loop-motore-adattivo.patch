+//
+//  AdaptiveTherapyModels.swift
+//  Loop
+//
+//  Tipi di supporto del motore adattivo retrospettivo.
+//  Vedi AdaptiveTherapyManager.swift per l'algoritmo.
+//
+
+import Foundation
+import HealthKit
+import LoopKit
+
+// MARK: - Configurazione
+
+/// Parametri del motore adattivo. Valori conservativi per default: il motore nasce in
+/// sola osservazione e non deve mai essere l'elemento che decide quanto e' aggressivo Loop.
+struct AdaptiveTherapyConfiguration: Codable, Equatable {
+
+    /// Giorni di storico da esaminare. Lo store locale e' configurato a 21 giorni
+    /// (LOOP_LOCAL_CACHE_DURATION_DAYS in LoopConfigOverride.xcconfig).
+    var analysisWindowDays: Int = 21
+
+    /// Ampiezza del bin. 30 minuti si allinea alle fasce del profilo basale.
+    var binDuration: TimeInterval = .minutes(30)
+
+    /// Limiti dell'adattamento. Sono un vincolo *sopra* ai Guardrail di LoopKit, non al
+    /// posto loro: qualunque moltiplicatore viene comunque riverificato contro quelli.
+    var minimumMultiplier: Double = 0.85
+    var maximumMultiplier: Double = 1.15
+
+    /// Passo massimo per singolo aggiornamento. Un motore che insegue il rumore e' peggio
+    /// di nessun motore.
+    var maximumStepPerUpdate: Double = 0.05
+
+    /// Intervallo minimo fra due aggiornamenti dei moltiplicatori.
+    var minimumUpdateInterval: TimeInterval = .hours(12)
+
+    /// Frazione minima dei giorni della finestra che deve contribuire a una fascia.
+    /// Una fascia riceve al massimo un bin per giorno, quindi la soglia va rapportata al
+    /// numero di giorni: un valore assoluto alto rende semplicemente impossibile che una
+    /// qualunque fascia diventi utilizzabile, e il motore non produce mai niente.
+    var minimumEffectiveSampleFraction: Double = 0.3
+    var minimumEffectiveSampleFloor: Double = 4
+
+    /// Numero efficace minimo di osservazioni per fascia (numerosita' di Kish).
+    var minimumEffectiveSamples: Double {
+        max(minimumEffectiveSampleFloor, Double(analysisWindowDays) * minimumEffectiveSampleFraction)
+    }
+
+    /// Ampiezza sotto la quale il movimento della glicemia e' rumore. Senza questo
+    /// pavimento un bin notturno pulitissimo con 0,4 contro 0,4 mg/dL/h si vedrebbe
+    /// dimezzare il peso da due numeri che non significano niente.
+    var movementNoiseFloorPerHour: Double = 5
+
+    /// Dispersione massima tollerata (MAD, in mg/dL per ora) oltre la quale il segnale
+    /// e' considerato non riproducibile e la fascia resta a 1,0.
+    var maximumDispersion: Double = 18
+
+    /// Carboidrati attivi oltre i quali il bin non vale nulla, in grammi. Nella fascia
+    /// peggiore la stima di assorbimento non e' affidabile abbastanza per meritare un
+    /// voto anche piccolo.
+    var hardCarbCutoffGrams: Double = 25
+
+    /// Grammi a cui il peso vale 0,5. Governa la pendenza della campana.
+    var carbHalfWeightGrams: Double = 8
+
+    /// Severita' aggiuntiva applicata quando la correzione che ne deriverebbe *aumenta*
+    /// l'insulina. I carboidrati residui spingono la glicemia verso l'alto, quindi un COB
+    /// sottostimato somiglia a "manca insulina": l'errore andrebbe dalla parte pericolosa.
+    var asymmetricPenaltyExponent: Double = 2.0
+
+    /// Coda di sicurezza dopo la fine dell'assorbimento osservato, prima che il peso
+    /// possa tornare a 1.
+    var absorptionSafetyTail: TimeInterval = .minutes(60)
+
+    /// Attenuazione applicata quando la Integral Retrospective Correction e' attiva.
+    /// L'IRC e' gia' un adattamento a 3 ore: sommare i due guadagni fa oscillare l'anello.
+    var integralRetrospectiveCorrectionAttenuation: Double = 0.5
+
+    /// Modello di attivita' insulinica usato per la deconvoluzione.
+    /// TODO: sostituire con la curva del modello insulinico effettivamente configurato.
+    var insulinPeakActivity: TimeInterval = .minutes(75)
+    var insulinActivityDuration: TimeInterval = .hours(6)
+
+    static let `default` = AdaptiveTherapyConfiguration()
+}
+
+// MARK: - Campioni
+
+/// Motivo per cui un bin vale poco o niente. Registrato perche' in fase di osservazione
+/// la domanda utile non e' "quanto propone" ma "perche' ha scartato quello che ha scartato".
+enum AdaptiveExclusionReason: String, Codable, CaseIterable {
+    case activeCarbs = "carboidrati attivi"
+    case longMealSuspected = "pasto lungo sospetto"
+    case manualBolus = "bolo manuale recente"
+    case overrideActive = "override attivo"
+    case glucoseGap = "buco nei dati CGM"
+    case belowSuspendThreshold = "sotto la soglia di sospensione"
+    case podChange = "cambio pod recente"
+    case insufficientData = "dati insufficienti"
+}
+
+/// Un intervallo elementare di analisi.
+struct AdaptiveBin: Codable {
+    let startDate: Date
+
+    /// Deviazione osservata, in mg/dL per ora. E' l'insulin counteraction effect:
+    /// variazione di glicemia osservata meno quella attribuibile all'insulina.
+    let counteractionPerHour: Double
+
+    /// Carboidrati ancora in assorbimento, in grammi.
+    let carbsOnBoard: Double
+
+    /// Quota del movimento di glicemia attribuita ai carboidrati, in mg/dL per ora.
+    let carbEffectPerHour: Double
+
+    /// Insulina attiva, in unita'. Usata come regressore per separare ISF da basale.
+    let insulinOnBoard: Double
+
+    /// Distanza dal centro del target, in mg/dL.
+    let glucoseDeviationFromTarget: Double
+
+    /// Peso finale del bin, fra 0 e 1.
+    let weight: Double
+
+    /// Motivi che hanno abbassato il peso.
+    let exclusions: [AdaptiveExclusionReason]
+}
+
+// MARK: - Risultato
+
+/// Raccomandazione per una singola fascia oraria.
+struct AdaptiveSlotRecommendation: Codable, Identifiable {
+    /// Minuti dalla mezzanotte a cui inizia la fascia.
+    let slotStartMinutes: Int
+
+    let basalMultiplier: Double
+    let insulinSensitivityMultiplier: Double
+
+    /// Somma dei pesi, corretta per la loro dispersione. E' la vera numerosita' del campione.
+    let effectiveSamples: Double
+
+    /// Dispersione (MAD) della deviazione, in mg/dL per ora.
+    let dispersion: Double
+
+    /// Falso quando la fascia non ha prodotto una raccomandazione utilizzabile.
+    let isActionable: Bool
+
+    let notes: [String]
+
+    var id: Int { slotStartMinutes }
+
+    var slotLabel: String {
+        String(format: "%02d:%02d", slotStartMinutes / 60, slotStartMinutes % 60)
+    }
+}
+
+/// Esito completo di un'analisi. Persistito cosi' com'e' per la schermata di osservazione.
+struct AdaptiveTherapyReport: Codable {
+    let generatedAt: Date
+    let windowStart: Date
+    let windowEnd: Date
+
+    let slots: [AdaptiveSlotRecommendation]
+
+    /// Quante ore di storico sono state esaminate e quante sono risultate leggibili.
+    let totalBins: Int
+    let effectiveBins: Double
+
+    /// Conteggio dei motivi di esclusione, per capire cosa sta mangiando i dati.
+    let exclusionCounts: [String: Int]
+
+    /// Pasti la cui durata osservata ha saturato il tetto del modello: sono i candidati
+    /// al suggerimento "dichiara questi pasti come lenti".
+    let saturatedMeals: [AdaptiveMealObservation]
+
+    /// Vero quando il motore non ha potuto concludere nulla, con il motivo.
+    let inconclusiveReason: String?
+
+    var actionableSlots: [AdaptiveSlotRecommendation] {
+        slots.filter { $0.isActionable }
+    }
+}
+
+/// Un pasto il cui assorbimento osservato ha toccato il tetto consentito dal modello.
+struct AdaptiveMealObservation: Codable, Identifiable {
+    let startDate: Date
+    let grams: Double
+    let declaredAbsorption: TimeInterval
+    let observedAbsorption: TimeInterval
+
+    var id: Date { startDate }
+
+    var ratio: Double {
+        guard declaredAbsorption > 0 else { return 1 }
+        return observedAbsorption / declaredAbsorption
+    }
+}
