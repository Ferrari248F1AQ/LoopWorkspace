+// MARK: - Stima per fascia
+
+private extension AdaptiveTherapyManager {
+
+    func estimateSlots(from bins: [AdaptiveBin], inputs: AdaptiveTherapyInputs) -> [AdaptiveSlotRecommendation] {
+        let calendar = Calendar.current
+        let binMinutes = Int(configuration.binDuration / 60)
+        guard binMinutes > 0 else { return [] }
+
+        var grouped: [Int: [AdaptiveBin]] = [:]
+        for bin in bins {
+            let components = calendar.dateComponents([.hour, .minute], from: bin.startDate)
+            let minutes = (components.hour ?? 0) * 60 + (components.minute ?? 0)
+            let slot = (minutes / binMinutes) * binMinutes
+            grouped[slot, default: []].append(bin)
+        }
+
+        let referenceMidnight = calendar.startOfDay(for: Date())
+        var results: [AdaptiveSlotRecommendation] = []
+
+        for slot in stride(from: 0, to: 24 * 60, by: binMinutes) {
+            let slotDate = referenceMidnight.addingTimeInterval(TimeInterval(slot * 60))
+            let slotBins = (grouped[slot] ?? []).filter { $0.weight > 0 }
+
+            let isf = inputs.insulinSensitivitySchedule
+                .quantity(at: slotDate)
+                .doubleValue(for: .milligramsPerDeciliter)
+            let scheduledBasal = inputs.basalSchedule.value(at: slotDate)
+
+            guard !slotBins.isEmpty, isf > 0, scheduledBasal > 0 else {
+                results.append(neutralSlot(slot, notes: ["nessun dato utilizzabile in questa fascia"]))
+                continue
+            }
+
+            let weights = slotBins.map { $0.weight }
+            let sumWeights = weights.reduce(0, +)
+            let sumSquaredWeights = weights.reduce(0) { $0 + $1 * $1 }
+
+            // Numerosita' efficace (Kish): con pesi tutti pari a 1 coincide con il conteggio,
+            // con pesi molto disuguali e' molto piu' bassa. E' piu' onesta di un conteggio secco.
+            let effectiveSamples = sumSquaredWeights > 0 ? (sumWeights * sumWeights) / sumSquaredWeights : 0
+
+            let values = slotBins.map { $0.counteractionPerHour }
+            let center = weightedMedian(values: values, weights: weights)
+            let dispersion = weightedMedian(values: values.map { abs($0 - center) }, weights: weights)
+
+            guard effectiveSamples >= configuration.minimumEffectiveSamples else {
+                results.append(neutralSlot(slot,
+                                           effectiveSamples: effectiveSamples,
+                                           dispersion: dispersion,
+                                           notes: [String(format: "campione efficace %.1f, sotto la soglia di %.0f",
+                                                          effectiveSamples, configuration.minimumEffectiveSamples)]))
+                continue
+            }
+
+            guard dispersion <= configuration.maximumDispersion else {
+                results.append(neutralSlot(slot,
+                                           effectiveSamples: effectiveSamples,
+                                           dispersion: dispersion,
+                                           notes: [String(format: "dispersione %.1f mg/dL/h: segnale non riproducibile", dispersion)]))
+                continue
+            }
+
+            // Scarto degli outlier: oltre 3 MAD dal centro robusto.
+            let threshold = max(3 * dispersion, 5.0)
+            let kept = slotBins.filter { abs($0.counteractionPerHour - center) <= threshold }
+            guard kept.count >= 3 else {
+                results.append(neutralSlot(slot,
+                                           effectiveSamples: effectiveSamples,
+                                           dispersion: dispersion,
+                                           notes: ["troppi valori anomali nella fascia"]))
+                continue
+            }
+
+            // Regressione pesata a due regressori.
+            // Costante -> errore di basale: sbaglia sempre allo stesso modo.
+            // (deviazione dal target x insulina attiva) -> errore di ISF: si vede solo
+            // quando c'e' una correzione in corso.
+            let regression = weightedRegression(
+                points: kept.map { (x: $0.glucoseDeviationFromTarget * $0.insulinOnBoard,
+                                    y: $0.counteractionPerHour,
+                                    w: $0.weight) }
+            )
+
+            // mg/dL/h diviso mg/dL per unita' = unita'/ora mancanti o in eccesso.
+            let basalDelta = regression.intercept / isf
+            var basalMultiplier = (scheduledBasal + basalDelta) / scheduledBasal
+
+            // Errore relativo di ISF. Approssimazione: l'insulina di correzione attiva
+            // produce, nell'arco della sua durata, circa IOB x ISF; il residuo per ora
+            // attribuito alla pendenza vale beta1 x deviazione tipica.
+            let meanAbsDeviation = kept.reduce(0.0) { $0 + abs($1.glucoseDeviationFromTarget) } / Double(kept.count)
+            let hours = configuration.insulinActivityDuration / 3600
+            let relativeIsfError = regression.slope * meanAbsDeviation * hours / isf
+            var isfMultiplier = 1 - relativeIsfError
+
+            // La Integral Retrospective Correction e' gia' un adattamento a tre ore:
+            // sommare i due guadagni fa oscillare l'anello.
+            if inputs.integralRetrospectiveCorrectionEnabled {
+                let attenuation = configuration.integralRetrospectiveCorrectionAttenuation
+                basalMultiplier = 1 + (basalMultiplier - 1) * attenuation
+                isfMultiplier = 1 + (isfMultiplier - 1) * attenuation
+            }
+
+            results.append(AdaptiveSlotRecommendation(
+                slotStartMinutes: slot,
+                basalMultiplier: clampMultiplier(basalMultiplier),
+                insulinSensitivityMultiplier: clampMultiplier(isfMultiplier),
+                effectiveSamples: effectiveSamples,
+                dispersion: dispersion,
+                isActionable: true,
+                notes: []
+            ))
+        }
+
+        return results
+    }
+
+    func neutralSlot(_ slot: Int,
+                     effectiveSamples: Double = 0,
+                     dispersion: Double = 0,
+                     notes: [String]) -> AdaptiveSlotRecommendation
+    {
+        AdaptiveSlotRecommendation(slotStartMinutes: slot,
+                                   basalMultiplier: 1,
+                                   insulinSensitivityMultiplier: 1,
+                                   effectiveSamples: effectiveSamples,
+                                   dispersion: dispersion,
+                                   isActionable: false,
+                                   notes: notes)
+    }
+
+    func clampMultiplier(_ value: Double) -> Double {
+        guard value.isFinite else { return 1 }
+        return min(max(value, configuration.minimumMultiplier), configuration.maximumMultiplier)
+    }
+
+    func weightedMedian(values: [Double], weights: [Double]) -> Double {
+        guard !values.isEmpty, values.count == weights.count else { return 0 }
+
+        let pairs = zip(values, weights).sorted { $0.0 < $1.0 }
+        let total = weights.reduce(0, +)
+        guard total > 0 else { return 0 }
+
+        var running = 0.0
+        for (value, weight) in pairs {
+            running += weight
+            if running >= total / 2 {
+                return value
+            }
+        }
+        return pairs.last?.0 ?? 0
+    }
+
+    func weightedRegression(points: [(x: Double, y: Double, w: Double)]) -> (intercept: Double, slope: Double) {
+        var sumW = 0.0, sumX = 0.0, sumY = 0.0, sumXX = 0.0, sumXY = 0.0
+
+        for point in points {
+            sumW += point.w
+            sumX += point.w * point.x
+            sumY += point.w * point.y
+            sumXX += point.w * point.x * point.x
+            sumXY += point.w * point.x * point.y
+        }
+
+        guard sumW > 0 else { return (0, 0) }
+
+        let denominator = sumW * sumXX - sumX * sumX
+
+        // Senza abbastanza variazione sul regressore ISF si stima solo la costante:
+        // e' il caso dei bin con insulina di correzione praticamente nulla, che infatti
+        // informano soltanto la basale.
+        guard abs(denominator) > 1e-9 else {
+            return (sumY / sumW, 0)
+        }
+
+        let slope = (sumW * sumXY - sumX * sumY) / denominator
+        let intercept = (sumY - slope * sumX) / sumW
+
+        return (intercept, slope)
+    }
+}
+
+// MARK: - Continuita' e gradualita'
+
+private extension AdaptiveTherapyManager {
+
+    /// Le fasce non sono indipendenti: la coda dell'insulina le lega, quindi un profilo a
+    /// denti di sega e' quasi sempre un artefatto. Media mobile circolare a tre punti.
+    func smooth(_ slots: [AdaptiveSlotRecommendation]) -> [AdaptiveSlotRecommendation] {
+        guard slots.count > 2 else { return slots }
+
+        return slots.indices.map { index in
+            let slot = slots[index]
+            guard slot.isActionable else { return slot }
+
+            let previous = slots[(index - 1 + slots.count) % slots.count]
+            let next = slots[(index + 1) % slots.count]
+
+            let basal = 0.25 * previous.basalMultiplier + 0.5 * slot.basalMultiplier + 0.25 * next.basalMultiplier
+            let isf = 0.25 * previous.insulinSensitivityMultiplier
+                + 0.5 * slot.insulinSensitivityMultiplier
+                + 0.25 * next.insulinSensitivityMultiplier
+
+            return AdaptiveSlotRecommendation(slotStartMinutes: slot.slotStartMinutes,
+                                              basalMultiplier: clampMultiplier(basal),
+                                              insulinSensitivityMultiplier: clampMultiplier(isf),
+                                              effectiveSamples: slot.effectiveSamples,
+                                              dispersion: slot.dispersion,
+                                              isActionable: true,
+                                              notes: slot.notes)
+        }
+    }
+
+    /// Mai sostituzione: si parte dallo stato precedente e ci si muove al massimo di un
+    /// passo. Un motore che insegue il rumore e' peggio di nessun motore.
+    func applyGradualUpdate(_ slots: [AdaptiveSlotRecommendation]) -> [AdaptiveSlotRecommendation] {
+        var basalState = storedMultipliers
+        var isfState = storedIsfMultipliers
+        let maxStep = configuration.maximumStepPerUpdate
+
+        func step(from previous: Double, to target: Double) -> Double {
+            previous + min(max(target - previous, -maxStep), maxStep)
+        }
+
+        let updated = slots.map { slot -> AdaptiveSlotRecommendation in
+            guard slot.isActionable else { return slot }
+
+            let basal = step(from: basalState[slot.slotStartMinutes] ?? 1.0, to: slot.basalMultiplier)
+            let isf = step(from: isfState[slot.slotStartMinutes] ?? 1.0, to: slot.insulinSensitivityMultiplier)
+
+            basalState[slot.slotStartMinutes] = basal
+            isfState[slot.slotStartMinutes] = isf
+
+            return AdaptiveSlotRecommendation(slotStartMinutes: slot.slotStartMinutes,
+                                              basalMultiplier: clampMultiplier(basal),
+                                              insulinSensitivityMultiplier: clampMultiplier(isf),
+                                              effectiveSamples: slot.effectiveSamples,
+                                              dispersion: slot.dispersion,
+                                              isActionable: true,
+                                              notes: slot.notes)
+        }
+
+        storedMultipliers = basalState
+        storedIsfMultipliers = isfState
+        return updated
+    }
+}
