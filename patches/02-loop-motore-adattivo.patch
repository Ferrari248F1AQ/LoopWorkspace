+// MARK: - Le due fonti dei dati
+
+private extension AdaptiveTherapyManager {
+
+    /// Serie calcolate dagli archivi locali di Loop. E' il percorso normale.
+    func localSeries(glucose: [StoredGlucoseSample], windowStart: Date, windowEnd: Date) async throws -> AdaptiveSeries {
+        let insulinEffects = try await insulinGlucoseEffects(start: windowStart, end: windowEnd)
+
+        // Insulin counteraction effect: quanto la glicemia si e' mossa al netto di cio' che
+        // l'insulina avrebbe dovuto fare. In una finestra senza carboidrati un ICE mediamente
+        // nullo significa che la basale e' giusta.
+        let counteraction = glucoseStore.counteractionEffects(for: glucose, to: insulinEffects)
+
+        let cobValues = try await carbsOnBoard(start: windowStart, end: windowEnd, velocities: counteraction)
+        let carbEffects = try await carbGlucoseEffects(start: windowStart, end: windowEnd, velocities: counteraction)
+        let iobValues = try await insulinOnBoardValues(start: windowStart, end: windowEnd)
+
+        return AdaptiveSeries(glucose: glucose,
+                              counteraction: counteraction,
+                              cobValues: cobValues,
+                              carbEffects: carbEffects,
+                              iobValues: iobValues,
+                              source: .localStores)
+    }
+
+    func historicalData(from service: HistoricalTherapyDataService,
+                        start: Date,
+                        end: Date) async throws -> HistoricalTherapyData
+    {
+        try await withCheckedThrowingContinuation { continuation in
+            service.fetchHistoricalTherapyData(interval: DateInterval(start: start, end: end)) { result in
+                switch result {
+                case .success(let data): continuation.resume(returning: data)
+                case .failure(let error): continuation.resume(throwing: error)
+                }
+            }
+        }
+    }
+
+    /// Ricostruisce le stesse cinque serie partendo da glicemie, dosi e carboidrati riletti
+    /// dalla fonte esterna, usando la matematica di LoopKit invece degli archivi.
+    ///
+    /// Non tocca nessun archivio locale. Scriverci dentro le dosi storiche sarebbe l'unica
+    /// operazione di tutto questo lavoro capace di influenzare l'insulina per sbaglio.
+    func backfilledSeries(from data: HistoricalTherapyData,
+                          windowStart: Date,
+                          windowEnd: Date,
+                          inputs: AdaptiveTherapyInputs) -> AdaptiveSeries?
+    {
+        guard let carbRatioSchedule = inputs.carbRatioSchedule else {
+            return nil
+        }
+
+        // Le tabelle devono coprire ogni voce, altrimenti dynamicGlucoseEffects fa cadere
+        // l'app con una precondition: si parte da un giorno prima e si arriva a mezza
+        // giornata dopo, e le voci fuori intervallo vengono scartate.
+        let timelineStart = windowStart.addingTimeInterval(-.hours(24))
+        let timelineEnd = windowEnd.addingTimeInterval(.hours(12))
+
+        let sensitivityTimeline = inputs.insulinSensitivitySchedule.quantitiesBetween(start: timelineStart, end: timelineEnd)
+        let carbRatioTimeline = carbRatioSchedule.between(start: timelineStart, end: timelineEnd)
+
+        guard !sensitivityTimeline.isEmpty, !carbRatioTimeline.isEmpty else {
+            return nil
+        }
+
+        let glucose = data.glucose.filter { $0.startDate >= windowStart && $0.startDate <= windowEnd }
+
+        let insulinEffects = data.doses.glucoseEffects(insulinSensitivityTimeline: sensitivityTimeline,
+                                                       from: windowStart,
+                                                       to: windowEnd)
+
+        let counteraction = glucoseStore.counteractionEffects(for: glucose, to: insulinEffects)
+
+        let iobValues = data.doses.insulinOnBoard(from: windowStart, to: windowEnd)
+
+        let carbEntries = data.carbEntries.filter { $0.startDate >= timelineStart && $0.startDate <= windowEnd }
+
+        let carbStatuses = carbEntries.map(to: counteraction,
+                                           carbRatio: carbRatioTimeline,
+                                           insulinSensitivity: sensitivityTimeline)
+
+        let cobValues = carbStatuses.dynamicCarbsOnBoard(from: windowStart, to: windowEnd)
+        let carbEffects = carbStatuses.dynamicGlucoseEffects(from: windowStart,
+                                                             to: windowEnd,
+                                                             carbRatios: carbRatioTimeline,
+                                                             insulinSensitivities: sensitivityTimeline)
+
+        return AdaptiveSeries(glucose: glucose,
+                              counteraction: counteraction,
+                              cobValues: cobValues,
+                              carbEffects: carbEffects,
+                              iobValues: iobValues,
+                              source: .nightscout)
+    }
+}
+
+// MARK: - Rapporto insulina/carboidrati
+
+private extension AdaptiveTherapyManager {
+
+    /// Date dei cambi pod, per capire se l'effetto dipende dall'eta' del sito.
+    ///
+    /// Disponibile solo sul percorso locale: gli eventi pompa non passano dalla fonte
+    /// esterna. Quando manca, la statistica per giorno del pod semplicemente non compare.
+    func podChangeDates(start: Date, end: Date) async throws -> [Date] {
+        let events: [PersistedPumpEvent] = try await withCheckedThrowingContinuation { continuation in
+            doseStore.getPumpEventValues(since: start) { result in
+                switch result {
+                case .success(let events): continuation.resume(returning: events)
+                case .failure(let error): continuation.resume(throwing: error)
+                }
+            }
+        }
+
+        return events
+            .filter { event in
+                guard let type = event.type else { return false }
+                switch type {
+                case .prime, .replaceComponent:
+                    return true
+                default:
+                    return false
+                }
+            }
+            .map { $0.date }
+            .filter { $0 <= end }
+            .sorted()
+    }
+
+    /// Valuta ogni pasto isolato: quanto ha fatto salire la glicemia rispetto a quanto il
+    /// modello si aspettava.
+    ///
+    /// L'escursione osservata e' l'integrale dell'insulin counteraction effect sulla finestra
+    /// del pasto, cioe' il movimento della glicemia al netto di tutta l'insulina che stava
+    /// agendo - il bolo del pasto incluso. Quella attesa e' grammi per il fattore
+    /// carboidrati. Se la prima supera la seconda, per quel pasto serviva piu' insulina.
+    func assessMeals(carbEntries: [StoredCarbEntry],
+                     counteraction: [GlucoseEffectVelocity],
+                     glucose: [StoredGlucoseSample],
+                     saturatedMeals: [AdaptiveMealObservation],
+                     podChanges: [Date],
+                     windowStart: Date,
+                     windowEnd: Date,
+                     inputs: AdaptiveTherapyInputs) -> [AdaptiveMealAssessment]
+    {
+        guard let carbRatioSchedule = inputs.carbRatioSchedule else { return [] }
+
+        let velocityUnit = HKUnit.milligramsPerDeciliterPerMinute
+        let saturatedDates = Set(saturatedMeals.map { $0.startDate })
+        let sorted = carbEntries.sorted { $0.startDate < $1.startDate }
+        var assessments: [AdaptiveMealAssessment] = []
+
+        for (index, entry) in sorted.enumerated() {
+            let grams = entry.quantity.doubleValue(for: .gram())
+            guard grams >= configuration.minimumMealGrams else { continue }
+
+            // Un pasto che ha saturato il tetto del modello non serve: non sappiamo dove
+            // finisce davvero, quindi non sappiamo su quale finestra integrare.
+            guard !saturatedDates.contains(entry.startDate) else { continue }
+
+            let declared = entry.absorptionTime ?? LoopCoreConstants.defaultCarbAbsorptionTimes.medium
+            let windowEndDate = entry.startDate
+                .addingTimeInterval(declared * CarbMath.defaultAbsorptionTimeOverrun)
+                .addingTimeInterval(configuration.mealIsolationTail)
+
+            guard windowEndDate <= windowEnd else { continue }
+
+            // Isolato: nessun altro pasto mentre questo sta ancora assorbendo.
+            let overlapped = sorted[(index + 1)...].contains { $0.startDate < windowEndDate }
+            guard !overlapped else { continue }
+
+            // Copertura CGM: senza dati non si integra niente di sensato.
+            let expectedSamples = windowEndDate.timeIntervalSince(entry.startDate) / .minutes(5)
+            let actualSamples = glucose.filter { $0.startDate >= entry.startDate && $0.startDate <= windowEndDate }.count
+            let coverage = expectedSamples > 0 ? Double(actualSamples) / expectedSamples : 0
+            guard coverage >= configuration.minimumMealGlucoseCoverage else { continue }
+
+            // Integrale dell'ICE sulla finestra, in mg/dL.
+            var observedRise = 0.0
+            for velocity in counteraction where velocity.startDate >= entry.startDate && velocity.startDate < windowEndDate {
+                let minutes = velocity.endDate.timeIntervalSince(velocity.startDate) / 60
+                guard minutes > 0 else { continue }
+                observedRise += velocity.quantity.doubleValue(for: velocityUnit) * minutes
+            }
+
+            // Attesa dal modello: grammi per il fattore carboidrati (ISF diviso CR).
+            let isf = inputs.insulinSensitivitySchedule
+                .quantity(at: entry.startDate)
+                .doubleValue(for: .milligramsPerDeciliter)
+            let carbRatio = carbRatioSchedule.value(at: entry.startDate)
+            guard isf > 0, carbRatio > 0 else { continue }
+
+            let modeledRise = grams * isf / carbRatio
+            guard modeledRise > 0 else { continue }
+
+            let ratio = observedRise / modeledRise
+
+            // Salita maggiore dell'attesa vuol dire che serviva piu' insulina per grammo,
+            // cioe' un rapporto piu' piccolo. Il moltiplicatore e' quindi l'inverso.
+            guard ratio > 0.01 else { continue }
+            let multiplier = clampMultiplier(1 / ratio)
+
+            // Peso: i pasti grandi hanno un rapporto segnale/rumore migliore, e la copertura
+            // CGM entra direttamente.
+            let sizeTerm = min(1, grams / 40)
+            let weight = max(0, min(1, sizeTerm * coverage))
+
+            let podDay = podChanges.last { $0 <= entry.startDate }.map { change in
+                Int(entry.startDate.timeIntervalSince(change) / .hours(24))
+            }
+
+            assessments.append(AdaptiveMealAssessment(
+                startDate: entry.startDate,
+                grams: grams,
+                observedRise: observedRise,
+                modeledRise: modeledRise,
+                multiplier: multiplier,
+                weight: weight,
+                podDay: podDay
+            ))
+        }
+
+        return assessments
+    }
+
+    func summarizeCarbRatio(from assessments: [AdaptiveMealAssessment]) -> AdaptiveCarbRatioRecommendation? {
+        let usable = assessments.filter { $0.weight > 0 }
+        guard !usable.isEmpty else {
+            return AdaptiveCarbRatioRecommendation(multiplier: 1, effectiveMeals: 0, dispersion: 0,
+                                                   isActionable: false,
+                                                   notes: ["nessun pasto isolato e completo nella finestra"],
+                                                   byPodDay: nil)
+        }
+
+        let weights = usable.map { $0.weight }
+        let values = usable.map { $0.multiplier }
+
+        let sumWeights = weights.reduce(0, +)
+        let sumSquaredWeights = weights.reduce(0) { $0 + $1 * $1 }
+        let effectiveMeals = sumSquaredWeights > 0 ? (sumWeights * sumWeights) / sumSquaredWeights : 0
+
+        let center = weightedMedian(values: values, weights: weights)
+        let dispersion = weightedMedian(values: values.map { abs($0 - center) }, weights: weights)
+
+        var notes: [String] = []
+        var actionable = true
+
+        if effectiveMeals < configuration.minimumEffectiveMeals {
+            actionable = false
+            notes.append(String(format: "solo %.1f pasti utilizzabili, ne servono %.0f",
+                                effectiveMeals, configuration.minimumEffectiveMeals))
+        }
+
+        if dispersion > configuration.maximumMealDispersion {
+            actionable = false
+            notes.append(String(format: "dispersione %.0f%%: i pasti non si somigliano abbastanza", dispersion * 100))
+        }
+
+        // Raggruppamento per eta' del pod: se l'effetto cambia col giorno del sito, si vede qui.
+        var byPodDay: [String: Double]? = nil
+        let withPodDay = usable.filter { $0.podDay != nil }
+        if withPodDay.count >= 6 {
+            var buckets: [String: [AdaptiveMealAssessment]] = [:]
+            for meal in withPodDay {
+                let day = meal.podDay ?? 0
+                let key = day >= 3 ? "3+" : "\(day)"
+                buckets[key, default: []].append(meal)
+            }
+            var summary: [String: Double] = [:]
+            for (key, meals) in buckets where meals.count >= 2 {
+                summary[key] = weightedMedian(values: meals.map { $0.multiplier },
+                                              weights: meals.map { $0.weight })
+            }
+            if summary.count >= 2 {
+                byPodDay = summary
+            }
+        }
+
+        return AdaptiveCarbRatioRecommendation(
+            multiplier: actionable ? clampMultiplier(center) : 1,
+            effectiveMeals: effectiveMeals,
+            dispersion: dispersion,
+            isActionable: actionable,
+            notes: notes,
+            byPodDay: byPodDay
+        )
+    }
+}
diff --git a/Loop/Loop/Managers/AdaptiveTherapyModels.swift b/Loop/Loop/Managers/AdaptiveTherapyModels.swift
new file mode 100644
index 00000000..493b8d54
--- /dev/null
+++ b/Loop/Loop/Managers/AdaptiveTherapyModels.swift
@@ -0,0 +1,277 @@
+//
+//  AdaptiveTherapyModels.swift
+//  Loop
+//
+//  Tipi di supporto del motore adattivo retrospettivo.
+//  Vedi AdaptiveTherapyManager.swift per l'algoritmo.
+//
+
+import Foundation
+import HealthKit
+import LoopKit
+
+// MARK: - Configurazione
+
+/// Parametri del motore adattivo. Valori conservativi per default: il motore nasce in
+/// sola osservazione e non deve mai essere l'elemento che decide quanto e' aggressivo Loop.
+struct AdaptiveTherapyConfiguration: Codable, Equatable {
+
+    /// Giorni di storico da esaminare. Lo store locale e' configurato a 21 giorni
+    /// (LOOP_LOCAL_CACHE_DURATION_DAYS in LoopConfigOverride.xcconfig).
+    var analysisWindowDays: Int = 21
+
+    /// Ampiezza del bin. 30 minuti si allinea alle fasce del profilo basale.
+    var binDuration: TimeInterval = .minutes(30)
+
+    /// Limiti dell'adattamento. Sono un vincolo *sopra* ai Guardrail di LoopKit, non al
+    /// posto loro: qualunque moltiplicatore viene comunque riverificato contro quelli.
+    var minimumMultiplier: Double = 0.85
+    var maximumMultiplier: Double = 1.15
+
+    /// Passo massimo per singolo aggiornamento. Un motore che insegue il rumore e' peggio
+    /// di nessun motore.
+    var maximumStepPerUpdate: Double = 0.05
+
+    /// Intervallo minimo fra due aggiornamenti dei moltiplicatori.
+    var minimumUpdateInterval: TimeInterval = .hours(12)
+
+    // --- Rapporto insulina/carboidrati ---
+
+    /// Sotto questa quantita' un pasto non dice niente sul rapporto: il rumore della
+    /// glicemia e' dello stesso ordine dell'escursione che il pasto produce.
+    var minimumMealGrams: Double = 15
+
+    /// Un pasto vale solo se e' isolato: nessun altro pasto mentre sta ancora assorbendo,
+    /// altrimenti non si sa a chi attribuire l'escursione.
+    var mealIsolationTail: TimeInterval = .minutes(45)
+
+    /// Numero efficace minimo di pasti perche' il rapporto produca una raccomandazione.
+    var minimumEffectiveMeals: Double = 6
+
+    /// Dispersione massima tollerata sui moltiplicatori dei pasti.
+    var maximumMealDispersion: Double = 0.25
+
+    /// Copertura CGM minima nella finestra del pasto.
+    var minimumMealGlucoseCoverage: Double = 0.7
+
+    /// Frazione della finestra che gli archivi locali devono coprire perche' li si usi.
+    /// Sotto questa soglia si prova la fonte esterna: dopo una reinstallazione in locale
+    /// non c'e' niente, mentre sul server lo storico c'e' da mesi.
+    var minimumLocalCoverage: Double = 0.6
+
+    /// Frazione minima dei giorni della finestra che deve contribuire a una fascia.
+    /// Una fascia riceve al massimo un bin per giorno, quindi la soglia va rapportata al
+    /// numero di giorni: un valore assoluto alto rende semplicemente impossibile che una
+    /// qualunque fascia diventi utilizzabile, e il motore non produce mai niente.
+    var minimumEffectiveSampleFraction: Double = 0.3
+    var minimumEffectiveSampleFloor: Double = 4
+
+    /// Numero efficace minimo di osservazioni per fascia (numerosita' di Kish).
+    var minimumEffectiveSamples: Double {
+        max(minimumEffectiveSampleFloor, Double(analysisWindowDays) * minimumEffectiveSampleFraction)
+    }
+
+    /// Ampiezza sotto la quale il movimento della glicemia e' rumore. Senza questo
+    /// pavimento un bin notturno pulitissimo con 0,4 contro 0,4 mg/dL/h si vedrebbe
+    /// dimezzare il peso da due numeri che non significano niente.
+    var movementNoiseFloorPerHour: Double = 5
+
+    /// Dispersione massima tollerata (MAD, in mg/dL per ora) oltre la quale il segnale
+    /// e' considerato non riproducibile e la fascia resta a 1,0.
+    var maximumDispersion: Double = 18
+
+    /// Carboidrati attivi oltre i quali il bin non vale nulla, in grammi. Nella fascia
+    /// peggiore la stima di assorbimento non e' affidabile abbastanza per meritare un
+    /// voto anche piccolo.
+    var hardCarbCutoffGrams: Double = 25
+
+    /// Grammi a cui il peso vale 0,5. Governa la pendenza della campana.
+    var carbHalfWeightGrams: Double = 8
+
+    /// Severita' aggiuntiva applicata quando la correzione che ne deriverebbe *aumenta*
+    /// l'insulina. I carboidrati residui spingono la glicemia verso l'alto, quindi un COB
+    /// sottostimato somiglia a "manca insulina": l'errore andrebbe dalla parte pericolosa.
+    var asymmetricPenaltyExponent: Double = 2.0
+
+    /// Coda di sicurezza dopo la fine dell'assorbimento osservato, prima che il peso
+    /// possa tornare a 1.
+    var absorptionSafetyTail: TimeInterval = .minutes(60)
+
+    /// Attenuazione applicata quando la Integral Retrospective Correction e' attiva.
+    /// L'IRC e' gia' un adattamento a 3 ore: sommare i due guadagni fa oscillare l'anello.
+    var integralRetrospectiveCorrectionAttenuation: Double = 0.5
+
+    /// Modello di attivita' insulinica usato per la deconvoluzione.
+    /// TODO: sostituire con la curva del modello insulinico effettivamente configurato.
+    var insulinPeakActivity: TimeInterval = .minutes(75)
+    var insulinActivityDuration: TimeInterval = .hours(6)
+
+    static let `default` = AdaptiveTherapyConfiguration()
+}
+
+// MARK: - Campioni
+
+/// Motivo per cui un bin vale poco o niente. Registrato perche' in fase di osservazione
+/// la domanda utile non e' "quanto propone" ma "perche' ha scartato quello che ha scartato".
+enum AdaptiveExclusionReason: String, Codable, CaseIterable {
+    case activeCarbs = "carboidrati attivi"
+    case longMealSuspected = "pasto lungo sospetto"
+    case manualBolus = "bolo manuale recente"
+    case overrideActive = "override attivo"
+    case glucoseGap = "buco nei dati CGM"
+    case belowSuspendThreshold = "sotto la soglia di sospensione"
+    case podChange = "cambio pod recente"
+    case insufficientData = "dati insufficienti"
+}
+
+/// Un intervallo elementare di analisi.
+struct AdaptiveBin: Codable {
+    let startDate: Date
+
+    /// Deviazione osservata, in mg/dL per ora. E' l'insulin counteraction effect:
+    /// variazione di glicemia osservata meno quella attribuibile all'insulina.
+    let counteractionPerHour: Double
+
+    /// Carboidrati ancora in assorbimento, in grammi.
+    let carbsOnBoard: Double
+
+    /// Quota del movimento di glicemia attribuita ai carboidrati, in mg/dL per ora.
+    let carbEffectPerHour: Double
+
+    /// Insulina attiva, in unita'. Usata come regressore per separare ISF da basale.
+    let insulinOnBoard: Double
+
+    /// Distanza dal centro del target, in mg/dL.
+    let glucoseDeviationFromTarget: Double
+
+    /// Peso finale del bin, fra 0 e 1.
+    let weight: Double
+
+    /// Motivi che hanno abbassato il peso.
+    let exclusions: [AdaptiveExclusionReason]
+}
+
+// MARK: - Risultato
+
+/// Raccomandazione per una singola fascia oraria.
+struct AdaptiveSlotRecommendation: Codable, Identifiable {
+    /// Minuti dalla mezzanotte a cui inizia la fascia.
+    let slotStartMinutes: Int
+
+    let basalMultiplier: Double
+    let insulinSensitivityMultiplier: Double
+
+    /// Somma dei pesi, corretta per la loro dispersione. E' la vera numerosita' del campione.
+    let effectiveSamples: Double
+
+    /// Dispersione (MAD) della deviazione, in mg/dL per ora.
+    let dispersion: Double
+
+    /// Falso quando la fascia non ha prodotto una raccomandazione utilizzabile.
+    let isActionable: Bool
+
+    let notes: [String]
+
+    var id: Int { slotStartMinutes }
+
+    var slotLabel: String {
+        String(format: "%02d:%02d", slotStartMinutes / 60, slotStartMinutes % 60)
+    }
+}
+
+/// Provenienza dei dati analizzati.
+enum AdaptiveDataSource: String, Codable {
+    case localStores = "archivi locali"
+    case nightscout = "Nightscout"
+}
+
+/// Esito completo di un'analisi. Persistito cosi' com'e' per la schermata di osservazione.
+struct AdaptiveTherapyReport: Codable {
+    /// Opzionale perche' i rapporti salvati prima che esistesse questo campo devono
+    /// continuare a decodificarsi.
+    let dataSource: AdaptiveDataSource?
+
+    let generatedAt: Date
+    let windowStart: Date
+    let windowEnd: Date
+
+    let slots: [AdaptiveSlotRecommendation]
+
+    /// Quante ore di storico sono state esaminate e quante sono risultate leggibili.
+    let totalBins: Int
+    let effectiveBins: Double
+
+    /// Conteggio dei motivi di esclusione, per capire cosa sta mangiando i dati.
+    let exclusionCounts: [String: Int]
+
+    /// Pasti la cui durata osservata ha saturato il tetto del modello: sono i candidati
+    /// al suggerimento "dichiara questi pasti come lenti".
+    let saturatedMeals: [AdaptiveMealObservation]
+
+    /// Rapporto insulina/carboidrati. Opzionale per non rompere i rapporti gia' salvati.
+    let carbRatio: AdaptiveCarbRatioRecommendation?
+
+    /// I singoli pasti valutati, per poter guardare i numeri invece di fidarsi della media.
+    let mealAssessments: [AdaptiveMealAssessment]?
+
+    /// Vero quando il motore non ha potuto concludere nulla, con il motivo.
+    let inconclusiveReason: String?
+
+    var actionableSlots: [AdaptiveSlotRecommendation] {
+        slots.filter { $0.isActionable }
+    }
+}
+
+/// Valutazione di un singolo pasto ai fini del rapporto insulina/carboidrati.
+struct AdaptiveMealAssessment: Codable, Identifiable {
+    let startDate: Date
+    let grams: Double
+
+    /// Escursione glicemica realmente attribuibile ai carboidrati, in mg/dL.
+    /// E' l'integrale dell'insulin counteraction effect sulla finestra del pasto: quello che
+    /// la glicemia ha fatto al netto di tutta l'insulina che stava agendo.
+    let observedRise: Double
+
+    /// Escursione che il modello si aspettava: grammi per il fattore carboidrati (ISF/CR).
+    let modeledRise: Double
+
+    /// Moltiplicatore proposto per il rapporto in quella fascia.
+    /// Sopra 1 vuol dire meno insulina per grammo, sotto 1 piu' insulina per grammo.
+    let multiplier: Double
+
+    /// Quanto pesa questo pasto nella statistica.
+    let weight: Double
+
+    /// Giorni trascorsi dall'ultimo cambio pod, se noto.
+    let podDay: Int?
+
+    var id: Date { startDate }
+}
+
+/// Raccomandazione complessiva sul rapporto insulina/carboidrati.
+struct AdaptiveCarbRatioRecommendation: Codable {
+    let multiplier: Double
+    let effectiveMeals: Double
+    let dispersion: Double
+    let isActionable: Bool
+    let notes: [String]
+
+    /// Moltiplicatore medio raggruppato per giorno di vita del pod, quando ci sono
+    /// abbastanza pasti per dire qualcosa. Chiave = giorno, valore = moltiplicatore.
+    let byPodDay: [String: Double]?
+}
+
+/// Un pasto il cui assorbimento osservato ha toccato il tetto consentito dal modello.
+struct AdaptiveMealObservation: Codable, Identifiable {
+    let startDate: Date
+    let grams: Double
+    let declaredAbsorption: TimeInterval
+    let observedAbsorption: TimeInterval
+
+    var id: Date { startDate }
+
+    var ratio: Double {
+        guard declaredAbsorption > 0 else { return 1 }
+        return observedAbsorption / declaredAbsorption
+    }
+}
